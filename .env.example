# =============================================================================
# Ismail Smart Agent V2.1 - Environment Configuration Template
# =============================================================================

# --- Agent Profile ---
AGENT_NAME="Ismail Smart Agent"
CREATOR_NAME="Ismail"
DEBUG=True

# --- LLM Provider Settings (Ollama / LiteLLM Proxy / OpenAI) ---
OLLAMA_URL=http://127.0.0.1:11434/api/generate
MODEL_NAME=qwen2.5:3b
TEMPERATURE=0.2
TIMEOUT=120

# Optional: Remote API keys for external models (OpenAI, Gemini, Anthropic)
OPENAI_API_KEY=
GEMINI_API_KEY=

# --- Server & Networking ---
HOST=0.0.0.0
PORT=8000
API_WORKERS=1
API_KEY=your_secure_api_key_here

# --- Security & Guardrails (Human-in-the-Loop) ---
# Options: "auto" (allow with audit logging), "strict" (block critical tools), "ask" (require manual approval)
GUARDRAILS_MODE=auto

# --- Self-Healing & Reflection Engine ---
ENABLE_SELF_HEALING=True
MAX_REFLECTION_ATTEMPTS=2

# --- Storage & Memory ---
MEMORY_FILE=memory.json
MAX_CONVERSATION_MESSAGES=30
UPLOADS_DIR=uploads

# --- External Integrations (Optional) ---
# n8n Workflow Webhook URL
N8N_WEBHOOK_URL=http://localhost:5678/webhook/ai-agent

# Telegram Bot Token (if using telegram_bot.py)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Email Sender SMTP Configuration (for send_email_report tool)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
